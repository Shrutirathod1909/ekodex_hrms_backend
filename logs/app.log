[2026-10-27T22:33:46.796Z] [LOG]

    SELECT
      c.id,
      c.company_name,
      c.contactable_person,
      c.email_id,
      c.phone,
      c.city,
      c.country,
      c.state,
      c.statecode,
      c.pincode,
      c.address,
      c.currency,
      c.fin_from,
      c.fin_to,
      c.gst_no,
      c.website,
      c.cin_no,
      c.vat_tin,
      c.cst_tin,
      c.iec,
      c.terms,
      c.invoiceprefix,
      c.active,
      c.logo,
      c.created_by,
      c.modified_by,
      c.created_by_name,
      c.modified_by_name,
      c.disabled_by,
      c.disabled_by_name,
      c.disabled_on,
      c.created_on,
      c.modified_on,
      c.superadmin_status
    FROM companies c
    WHERE 1 = 1
  
      AND (
        TRY_CAST(c.created_by AS INT) = @userId
        OR c.id IN (
          SELECT TRY_CAST(LTRIM(RTRIM(value)) AS INT)
          FROM STRING_SPLIT(
            (
              SELECT ISNULL(company_id, '')
              FROM users
              WHERE id = @userId
            ),
            ','
          )
          WHERE LTRIM(RTRIM(value)) <> ''
        )
      )
     ORDER BY c.id DESC

