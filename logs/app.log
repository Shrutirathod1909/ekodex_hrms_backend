    SELECT *
    FROM branch
    WHERE 1=1
  
    AND (
      TRY_CAST(branch.created_by AS INT) = @userId
      OR EXISTS (
        SELECT 1 FROM STRING_SPLIT((SELECT ISNULL(company_id, '') FROM users WHERE id = @userId), ',') s
