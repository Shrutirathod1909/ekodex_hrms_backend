      u.company_name AS company_name_actual,
      u.branch_name  AS branch_name_actual
    FROM users u
    WHERE (u.created_by = @userId OR u.id = @userId OR (',' + ISNULL(u.company_id, '') + ',' LIKE '%,1,%'))
    ORDER BY u.id DESC
  

